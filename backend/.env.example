# Backend configuration
# Copy to backend/.env:  cp backend/.env.example backend/.env
# Only GROQ_API_KEY is required for the Q&A. Everything else is optional.
#
# With Docker, docker-compose.yml sets the database settings (POSTGRES_*,
# NEO4J_URI, NEO4J_PASSWORD, CHROMA_HOST) itself. The database values below
# are only used when you run the backend without Docker.

# ── LLM providers ────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
LLM_MODEL=llama-3.3-70b-versatile

# Cloudflare Workers AI (vision and backup LLM)
CF_API_KEY=
CF_API_URL=
CF_BACKUP_API_KEY=
CF_BACKUP_URL=
CF_BACKUP2_API_KEY=
CF_BACKUP2_URL=
NVIDIA_API_KEY=
# OPENROUTER_API_KEY=

# ── Retrieval ────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Leave RERANK_PROVIDER empty to rerank with the local model.
# Set it to "jina" or "cohere" to use a hosted GPU API instead.
# Warning: the hosted API receives the text of your documents.
RERANK_PROVIDER=
JINA_API_KEY=
COHERE_API_KEY=
# RERANK_MODEL=jina-reranker-v2-base-multilingual
# RERANK_MAX_DOCS=100

# Local reranker (default model: BAAI/bge-reranker-v2-m3)
# RERANKER_ENABLED=true
# RERANKER_MODEL=
# RERANKER_FETCH_K=30
# RELEVANCE_BATCH_SIZE=8
# RELEVANCE_MAX_TOKENS=400

# ── Databases (used without Docker) ──────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bimlo
POSTGRES_USER=bimlo
POSTGRES_PASSWORD=bimlo

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localdev123
NEO4J_DATABASE=neo4j

CHROMA_HOST=localhost
# CHROMA_PERSIST_DIR=./data/chroma

# Folder of project JSON files read by scripts/ingest_json.py
# JSON_DIR=/app/data/donnees_json

# ── Server ───────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
MAX_UPLOAD_MB=50
# APP_NAME=
# DATA_DIR=

# ── Vision ───────────────────────────────────────────────
# VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
# VISION_MAX_DIM=2048
# SKIP_VISION=false

# ── Voice ────────────────────────────────────────────────
ELEVENLABS_API_KEY=
# WHISPER_LANGUAGE=
# MAX_AUDIO_MB=25

# ── News page ────────────────────────────────────────────
FIRECRAWL_API_KEY=
# NEWSDATA_API_KEY=
# CF_NEWS_API_KEY=
# CF_NEWS_URL=
# NEWS_CYCLE_DAYS=1
# NEWS_PAGE_SIZE=10
# NEWS_MAX_AGE_DAYS=30
# NEWS_CACHE_DIR=

# ── Auth and email ───────────────────────────────────────
GOOGLE_CLIENT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# CONTACT_TO=
# SESSION_TTL_HOURS=72
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7

# ── Logging and alerts ───────────────────────────────────
# LOG_DIR=./data/logs
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5
# ALERT_WEBHOOK_URL=
# ALERT_INGESTION_FAIL_THRESHOLD=2
# ALERT_JUDGE_FAIL_THRESHOLD=3

# Set by docker-compose.yml, nothing to do here: HF_HOME, LOGO_PATH
